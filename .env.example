APP_ORIGIN=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=
# Comma-separated HTTPS origins for custom OIDC providers (e.g. hosted Keycloak).
OIDC_ALLOWED_ORIGINS=
COOKIE_SECURE=false
# API and background worker use the same Redis. Docker supplies its own internal URL.
REDIS_URL=redis://127.0.0.1:6379

# Optional local semantic services. Docker uses internal URLs automatically.
OLLAMA_URL=http://127.0.0.1:11434
QDRANT_URL=http://127.0.0.1:6333

# Configure connector application IDs and encrypted secrets in the workspace Connectors pages.
# Identity-provider client settings are managed in workspace Settings.

# Public CNAME destination for workspace portal domains. HTTPS must be configured at your edge.
CUSTOM_DOMAIN_TARGET=


# Public marketing site's canonical URL; applied when the web image is rebuilt.
PUBLIC_SITE_URL=https://agentzuno.com/
