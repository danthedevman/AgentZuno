{
  "name": "agentzuno",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "vite preview --host 0.0.0.0 --port 3000",
    "dev": "vite",
    "test": "npm run build && npm run test:ui && npm --prefix api test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "node scripts/build.mjs",
    "dev:api": "npm --prefix api run dev",
    "start:api": "npm --prefix api start",
    "test:ui": "node --test test/*.test.js"
  },
  "devDependencies": {
    "jsdom": "^30.1.3",
    "prettier": "^3.6.2",
    "vite": "^7.3.7",
    "vite-plugin-solid": "^2.11.14"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/material-icons-outlined": "^5.3.0",
    "@fontsource/shippori-mincho": "^5.3.0",
    "@solidjs/router": "^1.0.0",
    "@tiptap/core": "^3.32.1",
    "@tiptap/extension-image": "^3.32.1",
    "@tiptap/pm": "^3.32.1",
    "@tiptap/starter-kit": "^3.32.1",
    "d3": "^7.9.0",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "marked": "^18.1.2",
    "solid-js": "^1.9.17"
  },
  "license": "Apache-2.0"
}
